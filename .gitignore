# ============================================================
# FocusTrace .gitignore
# Rust + Tauri + React/Vite + Inno Setup
# ============================================================

# ── Rust / Cargo ────────────────────────────────────────────
target/
**/*.rs.bk
Cargo.lock

# ── Node.js ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Vite / Frontend build ───────────────────────────────────
dist/
dist-ssr/
*.local

# ── Tauri ───────────────────────────────────────────────────
src-tauri/target/
src-tauri/WixTools/
src-tauri/gen/

# ── Inno Setup ──────────────────────────────────────────────
installer/output/
*.exe
!src-tauri/icons/*.exe

# ── SQLite база данных ──────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# ── Логи приложения ─────────────────────────────────────────
*.log
logs/

# ── Переменные окружения ────────────────────────────────────
.env
.env.*
!.env.example

# ── IDE — JetBrains (RustRover, WebStorm, CLion) ────────────
.idea/
*.iml
*.iws
*.ipr

# ── IDE — VS Code ───────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# ── IDE — Visual Studio ─────────────────────────────────────
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# ── Windows ─────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── macOS ───────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Временные файлы ─────────────────────────────────────────
*.tmp
*.temp
*.swp
*.swo
*~

# ── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo

# ── Тесты / Coverage ────────────────────────────────────────
coverage/
.nyc_output/