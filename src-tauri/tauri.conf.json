{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusTrace",
  "version": "0.1.2",
  "identifier": "com.focustrace.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FocusTrace",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "FocusTrace",
    "copyright": "© 2025 FocusTrace",
    "category": "Productivity",
    "shortDescription": "Windows productivity and focus tracker",
    "longDescription": "FocusTrace tracks your application usage and helps you maintain focus with Pomodoro timer, daily goals, streaks, and detailed analytics — all stored locally.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "endpoints": [
        "https://github.com/ShEIH24/FocusTrace/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRkNGMTNBRjBFOURFNUYKUldSZjN1bndPdkg4VDJDZEJqa2pvakJjeXpUVUI2SEFla2gvalhodVRWKzNpUFdMNWpydUlKQzYK"
    }
  }
}
